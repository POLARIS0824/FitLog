<?xml version="1.0" encoding="utf-8"?>
<!--
   Data Extraction Rules (API 31+) 备份规则。

   训练历史（workouts / exercise_logs / set_logs）、体重、用户资料是核心用户资产，
   云备份与设备间迁移均全部纳入。

   AI 服务商 API Key 以 AES-GCM 密文存于 Room：备份迁移到新设备后 Keystore 密钥
   不存在，但 AIProviderConfigMapper 经 KeystoreManager.decryptOrNull 将密文降级为
   空字符串（配置仍可展示，仅不可用于请求），不会崩溃——因此无需排除数据库。
-->
<data-extraction-rules>
    <cloud-backup/>
    <device-transfer/>
</data-extraction-rules>
