<?xml version="1.0" encoding="utf-8"?>
<!--
   Data Extraction Rules (API 31+) 备份规则。

   AI 设置依赖当前设备的 Keystore，不参与云备份或设备迁移。
   Markdown、草稿与用户确认结果不受此排除影响。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ai_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ai_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
